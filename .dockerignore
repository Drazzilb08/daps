# Ignore everything by default
*

# Allow these files/directories (for building the app)
!/main.py
!/requirements.txt
!/modules/
!/util/
!/config/
!/ui/
!/api/
!/VERSION
!/start.sh

# Exclude these (don't ship local build/test/editor files)
**/*~
**/*.log
**/.DS_Store
**/Thumbs.db
**/config.yml
**/Dockerfile
node_modules/
ui/node_modules/
ui/dist/
logs/
tests/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.swn
*.bak
Thumbs.db
*~